# Copy to .env, chmod 600, fill in. Never commit .env.
# Comments are on their own lines on purpose (inline comments are parsed
# differently by different .env loaders).

# --- Telegram (required) ---
# API_ID / API_HASH from https://my.telegram.org, BOT_TOKEN from @BotFather
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me

# --- Access control ---
# Comma-separated numeric Telegram user IDs
ADMIN_USER_IDS=
# Empty = public. Keep this set until security hardening is verified.
ALLOWED_USER_IDS=
BLOCKED_USER_IDS=
# command | off | links
GROUP_MODE=command

# --- Limits ---
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=10
MAX_ACTIVE_PER_USER=1
# jobs / seconds
USER_RATE_LIMIT=5/600
DAILY_JOB_CAP=500
# Hard ceiling ~2000 with MTProto; keep low for disk/bandwidth
MAX_FILE_MB=500
MAX_DURATION_SEC=1800
MAX_HEIGHT=720
ALLOW_PLAYLISTS=false
ALLOW_GENERIC_EXTRACTOR=false
ENABLE_TRANSCODE=false

# --- Timeouts (seconds) ---
PROBE_TIMEOUT_SEC=60
DOWNLOAD_TIMEOUT_SEC=900
PROCESS_TIMEOUT_SEC=300
UPLOAD_TIMEOUT_SEC=1200

# --- Storage (container paths) ---
JOB_DIR=/data/jobs
STATE_DIR=/data/state
SESSION_DIR=/data/session
# Optional, mounted read-only. Files: instagram.txt, youtube.txt, x.txt, facebook.txt, ...
COOKIES_DIR=/run/cookies
MIN_FREE_DISK_MB=2048
MAX_JOB_DIR_MB=3000
JOB_TTL_SEC=3600

# --- Logging ---
LOG_LEVEL=INFO
# json | text (text for local dev)
LOG_FORMAT=json
